# 3D interchange (glTF, FBX, OBJ, Alembic, STL, PLY, COLLADA)
# *.gltf -> text: JSON glTF; exporter dirs stay LFS via path rules at end of file
*.gltf         text
*.glb        filter=lfs diff=lfs merge=lfs -text
*.bin        filter=lfs diff=lfs merge=lfs -text
*.fbx        filter=lfs diff=lfs merge=lfs -text
# *.obj -> text: exporter output re-asserted by path rules at end of file
*.obj          text
# *.mtl -> text: plain-text material sidecar
*.mtl          text
# *.dae -> text: XML COLLADA, diffable
*.dae          text
*.abc        filter=lfs diff=lfs merge=lfs -text
*.stl        filter=lfs diff=lfs merge=lfs -text
*.ply        filter=lfs diff=lfs merge=lfs -text
*.3ds        filter=lfs diff=lfs merge=lfs -text
# USD family / NVIDIA Omniverse (Pixar-authoritative split)
# .usda is ASCII text -- keep it plain and diffable (that's the whole
# reason to choose .usda over .usdc). .usdc is binary crate, .usdz is a
# zipped package -- both LFS. .usd is ambiguous (either text or crate
# depending on save-time flag) -- LFS as safer default.
*.usda       text
*.usd        filter=lfs diff=lfs merge=lfs -text
*.usdc       filter=lfs diff=lfs merge=lfs -text
*.usdz       filter=lfs diff=lfs merge=lfs -text
